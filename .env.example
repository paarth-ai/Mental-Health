# Local Development Environment Variables
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database (only needed for Vercel/Production)
# Sign up for a free PostgreSQL database at:
# - Supabase: https://supabase.com (Free tier with 500MB storage)
# - Neon: https://neon.tech (Free tier with shared compute)
# - Railway: https://railway.app
# Then set this variable to your PostgreSQL connection URL:
# DATABASE_URL=postgresql://user:password@host:port/database

# Example DATABASE_URL format:
# DATABASE_URL=postgresql://user:password@localhost:5432/mental_health_db
