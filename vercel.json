{
  "buildCommand": "pip install -r requirements.txt && python manage.py migrate && python manage.py collectstatic --noinput",
  "framework": "django",
  "python": {
    "version": "3.12"
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "mental_health_survey/wsgi.py"
    }
  ],
  "env": {
    "DEBUG": "False"
  }
}
